<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 浅色主题 ============ -->
    <Color x:Key="AppBackgroundColor">#F3F3F3</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />

    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5" />

    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#E0E0E0" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A" />

    <!-- 强调色由 ThemeManager 按系统设置在运行时覆盖 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A75C8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#00539E" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChipCheckedBackgroundBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="ChipCheckedTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E5E5E5" />

    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ChipFixedBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ChipFixedTextBrush" Color="#8A8A8A" />

    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5E5" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CFCFCF" />

    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#EDF4FB" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#D3E3F3" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#3C4A57" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CDCDCD" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />

</ResourceDictionary>
