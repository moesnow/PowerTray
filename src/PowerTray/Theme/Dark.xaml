<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 深色主题 ============ -->
    <Color x:Key="AppBackgroundColor">#202020</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />

    <Color x:Key="CardBackgroundColor">#2B2B2B</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />

    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#454545" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFCFCF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A" />

    <!-- 强调色由 ThemeManager 按系统设置在运行时覆盖 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#68CDFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3AB1E8" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="ChipCheckedBackgroundBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="ChipCheckedTextBrush" Color="#000000" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#2E2E2E" />

    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="ChipFixedBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ChipFixedTextBrush" Color="#9A9A9A" />

    <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3A3A" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#5A5A5A" />

    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#1B2A36" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#2C4254" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#D3E3F3" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />

</ResourceDictionary>
