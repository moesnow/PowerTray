<Window x:Class="PowerTray.Views.QuickPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerTray"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseLeftButtonDown="OnBlankAreaMouseDown"
        PreviewMouseRightButtonDown="OnBlankAreaMouseDown"
        Deactivated="OnDeactivated">

    <Border x:Name="RootPanel"
            CornerRadius="10"
            MinWidth="336"
            MaxWidth="392"
            Padding="18,15,18,12"
            Background="{DynamicResource FlyoutBackgroundBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.32" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <TextBlock Text="电源设置" Style="{StaticResource PopupTitle}" />
                <TextBlock Text="点击空白处关闭"
                           Style="{StaticResource TertiaryText}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 笔记本：接通电源 / 使用电池 切换 -->
            <Border x:Name="SourceSelectorPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource ChipFixedBackgroundBrush}"
                    CornerRadius="6"
                    Padding="3"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="AcRadio"
                                 Content="接通电源"
                                 GroupName="PowerSource"
                                 Style="{StaticResource SegmentedItem}"
                                 Checked="OnPowerSourceChanged" />
                    <RadioButton x:Name="DcRadio"
                                 Grid.Column="1"
                                 Content="使用电池"
                                 GroupName="PowerSource"
                                 Style="{StaticResource SegmentedItem}"
                                 Checked="OnPowerSourceChanged" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="SectionsScroll"
                          MaxHeight="470"
                          Margin="0,2,2,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SectionsHost" />
            </ScrollViewer>

            <Separator Style="{StaticResource AppSeparator}" Margin="0,12,0,6" />
            <TextBlock Text="更改立即生效 · 点击空白处或按 Esc 关闭"
                       Style="{StaticResource TertiaryText}"
                       FontSize="11" />
        </StackPanel>
    </Border>
</Window>
