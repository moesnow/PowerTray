<Window x:Class="PowerTray.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerTray"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseLeftButtonDown="OnBlankAreaMouseDown"
        PreviewMouseRightButtonDown="OnBlankAreaMouseDown"
        Deactivated="OnDeactivated">

    <Border x:Name="RootPanel"
            CornerRadius="8"
            MinWidth="184"
            Padding="4"
            Background="{DynamicResource FlyoutBackgroundBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.3" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Button x:Name="SettingsButton" Content="设置(_S)" Style="{StaticResource MenuButton}" Click="OnSettings" />
            <Separator Style="{StaticResource AppSeparator}" />
            <Button x:Name="ExitButton" Content="退出(_X)" Style="{StaticResource MenuButton}" Click="OnExit" />
        </StackPanel>
    </Border>
</Window>
